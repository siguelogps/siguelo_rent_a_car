# Solo lo mínimo del proceso. Las conexiones de cada rentacar (plataforma GPS, pagos, SimpleAPI, WhatsApp,
# correo, almacenamiento y TAG/multas del dashboard Síguelo) se cargan desde Configuración › Integraciones.
PORT=3000
NODE_ENV=development
# PostgreSQL. Vacío = PGlite embebido (desarrollo y demo; con PGLITE_DIR persiste en disco local).
DATABASE_URL=
PGLITE_DIR=
# Llave para cifrar las credenciales de las integraciones. En producción es obligatoria y no debe cambiar.
APP_SECRET=
# URL pública (para QR de contratos, enlaces del portal y retorno de pagos). En Render se toma RENDER_EXTERNAL_URL.
URL_BASE=https://onrent.siguelogps.com
# 1 = crear el rentacar de prueba si la base está vacía
SEMBRAR_DEMO=1
# 0 = no correr tareas programadas en esta instancia (si se escala a varias)
TAREAS=1
# Opcional: clave de la API de la CMF (api.cmfchile.cl) para UF, dólar observado y UTM oficiales.
# Sin ella se usan los valores del Banco Central publicados en mindicador.cl.
API_KEY_CMF=
# Superadmin de Síguelo (administra todas las empresas). La clave solo se usa al crearlo; después se cambia en «Mi cuenta».
SUPERADMIN_CORREO=pablo@siguelogps.cl
SUPERADMIN_CLAVE=
SUPERADMIN_NOMBRE=Pablo
